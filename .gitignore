```gitignore
# Dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/

# Build outputs
dist/
build/
.next/
out/
.nuxt/
public/dist/

# Logs
*.log
.log

# Environment variables
.env
.env.local
.env.*
!.env.example

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-selfcheck.json
*.so
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.git/
.mypy_cache/
.pytest_cache/
.hypothesis/
tox.ini
.pyup.yml
.coveralls.yml
*.pot
*.mo
migrations/
instance/
.webassets-cache
celerybeat-schedule
celerybeat.pid

# JavaScript
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled binary files
*.exe
*.dll
*.so
*.dylib

# Compressed archives
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.7z
*.rar
*.gz
*.bz2
*.xz
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo

# Coverage directory used by tools like istanbul
coverage/
coverage/lcov-report/

# Temporary folders
tmp/
temp/
```